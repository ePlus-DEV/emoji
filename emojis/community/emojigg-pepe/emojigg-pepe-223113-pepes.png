<script type="text/javascript">
self.loadPW = function() {
  var defaultUnits = [{type: 'bottom_rail'}, {type: 'corner_ad_video'}, {type: 'flex_leaderboard'}, {type: 'in_content'}, {type: 'left_rail'}, {type: 'right_rail'}];
  var noDisplay = ['login', 'submit', 'dashboard', 'submitpack', 'submitsticker', 'account', 'faq', 'content', 'privacy', 'category9nsfw', 'adminapprovals', 'adminapprovalsemojis', 'marketplace', 'product', 'about', 'toolsemoji-animator'];
  if(noDisplay.includes($(location).attr("pathname").replace(/\//g, "")) || noDisplay.includes($(location).attr("pathname").substring(0, $(location).attr("pathname").lastIndexOf("/") ).replace(/\//g, ""))) return;
  ($('#pwDeskLbAtf').length > 0) ?  window.ramp.addUnits([{ selectorId: 'pwDeskLbAtf', type: 'leaderboard_atf' }]) : '';
  ($('#pwMobiMedRectAtf').length > 0) ?  window.ramp.addUnits([{ selectorId: 'pwMobiMedRectAtf', type: 'med_rect_atf' }]) : '';
  window.ramp.addUnits(defaultUnits).then( () => {
       window.ramp.displayUnits();
   }).catch( (e) =>{
       console.log(e);
   });
}
window.ramp.onReady = function initFunction(){
  self.loadPW();
}

App.checkIfUserSmells(function(smelly) {
  if (smelly == true) {
    window.onload = function() {
      document.getElementById("yousmell").style.display = "block";
    }
  }
});
if (self.downloadCount >= 300) {
    window.onload = function() {
      document.getElementById("downloadlimit").style.display = "block";
  }
}

(function () {
  var ua = navigator.userAgent.toLowerCase();
  var cookieName = 'hide_android_banner';

  function hasCookie(name) {
    return document.cookie.indexOf(name + '=1') !== -1;
  }

  function setCookie(name, hours) {
    var d = new Date();
    d.setTime(d.getTime() + hours * 60 * 60 * 1000);
    document.cookie = name + '=1; expires=' + d.toUTCString() + '; path=/';
  }

  var isAndroid = ua.indexOf('android') !== -1;
  var isBrowser = /(chrome|firefox|safari|edge|opera)/.test(ua);
  var isWebView = /(wv|webview|fbav|instagram|twitter|discord)/.test(ua);

  if (isAndroid && isBrowser && !isWebView && !hasCookie(cookieName)) {
    var banner = document.getElementById('android');
    var close  = document.getElementById('android-close');

    banner.style.display = 'block';

    close.onclick = function () {
      banner.style.display = 'none';
      setCookie(cookieName, 12); // 12 hours
    };
  }
})();


</script>
