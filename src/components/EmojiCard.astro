---
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';

interface Emoji {
  slug: string;
  name: string;
  shortcode: string;
  emoji: string;
  image: string;
  source: string;
  hexcode: string;
  sourceLabel: string;
  license: string;
  tags: string[];
  group: string;
  category?: string;
  categorySlug?: string;
  format?: string;
  animated: boolean;
}

interface Props {
  emoji: Emoji;
}

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const detailUrl = withBase(`/emoji/${emoji.slug}`, base);
const category = emoji.category || emoji.group.replaceAll('-', ' ');
const searchText = [
  emoji.name,
  emoji.shortcode,
  emoji.sourceLabel,
  emoji.group,
  emoji.category,
  emoji.categorySlug,
  ...emoji.tags
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---
<article
  class="emoji-card"
  data-emoji-card
  data-search={searchText}
  data-source={emoji.sourceLabel.toLowerCase()}
  data-group={emoji.group}
  data-category={category.toLowerCase()}
  data-animated={emoji.animated ? 'yes' : 'no'}
>
  <a class="emoji-preview" href={detailUrl} aria-label={`Open ${emoji.name}`}>
    <img src={imageUrl} alt={emoji.name} loading="lazy" width="128" height="128" />
    {emoji.animated && <span class="card-motion-badge">GIF</span>}
  </a>
  <div class="emoji-card-body">
    <div class="emoji-title-row">
      <a class="emoji-name" href={detailUrl}>{emoji.name}</a>
      <span class="native-emoji" aria-hidden="true">{emoji.emoji}</span>
    </div>
    <button
      class="shortcode"
      type="button"
      data-copy={`:${emoji.shortcode}:`}
      title="Copy shortcode"
      aria-label={`Copy shortcode :${emoji.shortcode}:`}
    >
      :{emoji.shortcode}:
    </button>
    <div class="emoji-meta">
      <span>{category}</span>
      <span>{emoji.animated ? 'Animated' : (emoji.format || 'Static').toUpperCase()}</span>
    </div>
  </div>
</article>
