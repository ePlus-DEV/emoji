---
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';

interface Emoji {
  slug: string;
  name: string;
  shortcode: string;
  emoji: string;
  image: string;
  source: string;
  hexcode: string;
  sourceLabel: string;
  license: string;
  tags: string[];
  group: string;
  category?: string;
  categorySlug?: string;
  format?: string;
  animated: boolean;
}

interface Props {
  emoji: Emoji;
}

const { emoji } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageUrl = emojiAssetUrl(emoji, base);
const detailUrl = withBase(`/emoji/${emoji.slug}`, base);
const category = emoji.category || emoji.group.replaceAll('-', ' ');
const extension = (emoji.format || imageUrl.match(/\.([a-z0-9]+)(?:\?|$)/i)?.[1] || 'png').toLowerCase();
const downloadFilename = `${emoji.slug}.${extension}`;
const searchText = [
  emoji.name,
  emoji.shortcode,
  emoji.sourceLabel,
  emoji.group,
  emoji.category,
  emoji.categorySlug,
  ...emoji.tags
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---
<article
  class="emoji-card"
  data-emoji-card
  data-search={searchText}
  data-source={emoji.sourceLabel.toLowerCase()}
  data-group={emoji.group}
  data-category={category.toLowerCase()}
  data-animated={emoji.animated ? 'yes' : 'no'}
  data-download-key={emoji.slug}
  data-download-name={emoji.name}
  data-download-url={imageUrl}
  data-download-filename={downloadFilename}
>
  <label class="emoji-select-control" title={`Select ${emoji.name}`}>
    <input type="checkbox" data-emoji-select aria-label={`Select ${emoji.name}`} />
    <span aria-hidden="true">✓</span>
  </label>

  <a
    class="emoji-card-download"
    href={imageUrl}
    download={downloadFilename}
    title={`Download ${emoji.name}`}
    aria-label={`Download ${emoji.name}`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>

  <a class="emoji-preview" href={detailUrl} aria-label={`Open ${emoji.name}`}>
    <img src={imageUrl} alt={emoji.name} loading="lazy" width="128" height="128" />
    {emoji.animated && <span class="card-motion-badge">GIF</span>}
  </a>
  <div class="emoji-card-body">
    <div class="emoji-title-row">
      <a class="emoji-name" href={detailUrl}>{emoji.name}</a>
      <span class="native-emoji" aria-hidden="true">{emoji.emoji}</span>
    </div>
    <button
      class="shortcode"
      type="button"
      data-copy={`:${emoji.shortcode}:`}
      title="Copy shortcode"
      aria-label={`Copy shortcode :${emoji.shortcode}:`}
    >
      :{emoji.shortcode}:
    </button>
    <div class="emoji-meta">
      <span>{category}</span>
      <span>{emoji.animated ? 'Animated' : (emoji.format || 'Static').toUpperCase()}</span>
    </div>
  </div>
</article>
