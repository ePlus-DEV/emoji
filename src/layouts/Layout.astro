---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ePlus Emoji',
  description = 'An open custom emoji directory for developers and communities.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const homeUrl = withBase('/', base);
const emojisUrl = withBase('/emojis', base);
const faviconUrl = withBase('/favicon.svg', base);
const apiUrl = withBase('/api/emojis.json', base);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111827" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeUrl} aria-label="ePlus Emoji home">
          <span class="brand-mark">😀</span>
          <span>ePlus Emoji</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={homeUrl}>Home</a>
          <a href={emojisUrl}>Emojis</a>
          <a href={apiUrl}>API</a>
          <a href="https://github.com/ePlus-DEV/emoji" rel="noreferrer">GitHub</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Built by ePlus.DEV. Emoji assets keep their upstream licenses and attribution.</p>
        <a href="https://github.com/ePlus-DEV/emoji/blob/main/NOTICE.md">Licenses & attribution</a>
      </div>
    </footer>
  </body>
</html>
