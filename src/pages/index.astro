---
import Layout from '../layouts/Layout.astro';
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';
import emojis from '../data/emojis.json';
import categories from '../data/categories.json';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const allEmojiUrl = withBase('/emojis', base);
const apiUrl = withBase('/api/emojis.json', base);
const animatedCount = emojis.filter((emoji) => emoji.animated).length;
const sourceCount = new Set(emojis.map((emoji) => emoji.source)).size;

const shuffle = (items) => {
  const pool = [...items];
  for (let index = pool.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [pool[index], pool[swapIndex]] = [pool[swapIndex], pool[index]];
  }
  return pool;
};

const heroPool = shuffle(emojis)
  .slice(0, Math.min(120, emojis.length))
  .map((emoji) => ({
    id: emoji.id,
    slug: emoji.slug,
    name: emoji.name,
    image: emojiAssetUrl(emoji, base),
    animated: Boolean(emoji.animated)
  }));
const showcase = heroPool.slice(0, 12);
const heroPoolIds = new Set(heroPool.map((emoji) => emoji.id));
const heroPoolJson = JSON.stringify(heroPool).replaceAll('<', '\\u003c');
const animated = emojis
  .filter((emoji) => emoji.animated && !heroPoolIds.has(emoji.id))
  .slice(0, 12);
const staticEmoji = emojis
  .filter((emoji) => !emoji.animated && !heroPoolIds.has(emoji.id))
  .slice(0, 12);
const topCategories = [...categories].sort((a, b) => b.count - a.count).slice(0, 10);

const sections = [
  { title: 'Animated reactions', subtitle: 'GIFs and moving emoji for expressive conversations.', items: animated, href: `${allEmojiUrl}?motion=yes` },
  { title: 'Static emoji', subtitle: 'Lightweight assets for Slack, Discord and the web.', items: staticEmoji, href: `${allEmojiUrl}?motion=no` }
];
---
<Layout
  title="ePlus Emoji — Searchable emoji, GIFs and reactions"
  description="Browse a fast, searchable library of animated GIF emoji, static emoji and reactions with source and license metadata."
>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="hero-content">
        <p class="hero-kicker">Open emoji directory</p>
        <h1>Emoji, organized.</h1>
        <p class="hero-lead">Search a growing library of custom emoji, reactions and GIFs. Every asset keeps its source, format and attribution metadata.</p>

        <form class="hero-search" action={allEmojiUrl} method="get">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <input type="search" name="q" placeholder="Search name, :shortcode:, tag or category" aria-label="Search emoji" />
          <button type="submit">Search</button>
        </form>

        <div class="hero-meta" aria-label="Library statistics">
          <span><strong>{emojis.length.toLocaleString('en-US')}</strong> emoji</span>
          <span><strong>{animatedCount.toLocaleString('en-US')}</strong> animated</span>
          <span><strong>{categories.length}</strong> categories</span>
          <span><strong>{sourceCount}</strong> sources</span>
        </div>
      </div>

      <div class="hero-library" aria-label="Random emoji picks">
        <div class="hero-library-head">
          <div>
            <span class="status-dot" aria-hidden="true"></span>
            <strong>Random picks</strong>
          </div>
          <div class="hero-library-actions">
            <span>{emojis.length.toLocaleString('en-US')} assets</span>
            <button
              class="hero-shuffle"
              id="hero-shuffle"
              type="button"
              aria-controls="hero-random-grid"
              aria-label="Show another random set of emoji"
              title="Shuffle random emoji"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Shuffle</span>
            </button>
          </div>
        </div>
        <div class="hero-library-grid" id="hero-random-grid">
          {showcase.map((emoji) => (
            <a href={withBase(`/emoji/${emoji.slug}`, base)} title={emoji.name}>
              <img src={emoji.image} alt={emoji.name} loading="eager" width="80" height="80" />
              {emoji.animated && <span>GIF</span>}
            </a>
          ))}
        </div>
        <div class="hero-library-foot">
          <span>12 random picks from the catalog</span>
          <a href={allEmojiUrl}>Browse all →</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="hero-random-pool" set:html={heroPoolJson}></script>
  <script>
    const poolNode = document.querySelector('#hero-random-pool');
    const randomGrid = document.querySelector('#hero-random-grid');
    const shuffleButton = document.querySelector('#hero-shuffle');

    if (poolNode && randomGrid) {
      try {
        const pool = JSON.parse(poolNode.textContent || '[]');
        let currentSignature = '';

        const shufflePool = () => {
          for (let index = pool.length - 1; index > 0; index -= 1) {
            const swapIndex = Math.floor(Math.random() * (index + 1));
            [pool[index], pool[swapIndex]] = [pool[swapIndex], pool[index]];
          }
        };

        const renderRandom = () => {
          let picks = [];
          for (let attempt = 0; attempt < 4; attempt += 1) {
            shufflePool();
            picks = pool.slice(0, 12);
            const nextSignature = picks.map((emoji) => emoji.id).join('|');
            if (nextSignature !== currentSignature || pool.length <= 12) {
              currentSignature = nextSignature;
              break;
            }
          }

          const fragment = document.createDocumentFragment();
          for (const emoji of picks) {
            const link = document.createElement('a');
            link.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/emoji/${emoji.slug}`;
            link.title = emoji.name;

            const image = document.createElement('img');
            image.src = emoji.image;
            image.alt = emoji.name;
            image.loading = 'eager';
            image.width = 80;
            image.height = 80;
            link.append(image);

            if (emoji.animated) {
              const badge = document.createElement('span');
              badge.textContent = 'GIF';
              link.append(badge);
            }

            fragment.append(link);
          }
          randomGrid.replaceChildren(fragment);
        };

        renderRandom();
        shuffleButton?.addEventListener('click', renderRandom);
      } catch (error) {
        console.error('Could not shuffle hero emoji', error);
      }
    }
  </script>

  <section class="shell category-section" aria-labelledby="category-title">
    <div class="section-heading-modern category-heading">
      <div>
        <p class="section-kicker">Categories</p>
        <h2 id="category-title">Browse popular collections</h2>
      </div>
      <a href={allEmojiUrl}>View all <span>→</span></a>
    </div>
    <div class="category-list">
      {topCategories.map((category) => (
        <a class="category-chip" href={`${allEmojiUrl}?category=${encodeURIComponent(category.name.toLowerCase())}`}>
          <span>{category.name}</span>
          <small>{category.count.toLocaleString('en-US')}</small>
        </a>
      ))}
    </div>
  </section>

  {sections.map((section) => section.items.length > 0 && (
    <section class="shell emoji-section">
      <div class="section-heading-modern">
        <div>
          <p class="section-kicker">Library</p>
          <h2>{section.title}</h2>
          <p>{section.subtitle}</p>
        </div>
        <a href={section.href}>View all <span>→</span></a>
      </div>

      <div class="home-emoji-grid">
        {section.items.map((emoji) => {
          const detailUrl = withBase(`/emoji/${emoji.slug}`, base);
          const imageUrl = emojiAssetUrl(emoji, base);
          return (
            <a class="home-emoji-card" href={detailUrl} title={emoji.name}>
              <div class="home-emoji-preview">
                <img src={imageUrl} alt={emoji.name} loading="lazy" width="120" height="120" />
                {emoji.animated && <span class="motion-badge">GIF</span>}
              </div>
              <div class="home-emoji-info">
                <strong>{emoji.name}</strong>
                <span>:{emoji.shortcode}:</span>
                <small>{emoji.category || emoji.sourceLabel}</small>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section class="shell developer-banner">
    <div>
      <p class="section-kicker">Developer API</p>
      <h2>Use the catalog in your own tools.</h2>
      <p>Consume the public JSON index for search, integrations and custom emoji workflows.</p>
    </div>
    <div class="developer-actions">
      <a class="button-secondary" href={apiUrl}>JSON API</a>
      <a class="button-primary" href="https://github.com/vietnam-awesome/emoji" rel="noreferrer">GitHub</a>
    </div>
  </section>
</Layout>

<style>
  .hero-library-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-shuffle {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #fff;
    color: var(--ink-soft);
    font: inherit;
    font-size: .68rem;
    font-weight: 720;
    cursor: pointer;
    transition: border-color .14s ease, background .14s ease, color .14s ease;
  }

  .hero-shuffle:hover {
    border-color: var(--line-strong);
    background: #f8f9fb;
    color: var(--ink);
  }

  .hero-shuffle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .hero-shuffle svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 520px) {
    .hero-library-actions > span {
      display: none;
    }

    .hero-shuffle span {
      display: none;
    }

    .hero-shuffle {
      width: 30px;
      justify-content: center;
      padding: 0;
    }
  }
</style>