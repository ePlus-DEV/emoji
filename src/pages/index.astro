---
import Layout from '../layouts/Layout.astro';
import EmojiCard from '../components/EmojiCard.astro';
import emojis from '../data/emojis.json';

const groups = [...new Set(emojis.map((emoji) => emoji.group))].sort();
const sources = [...new Set(emojis.map((emoji) => emoji.sourceLabel))].sort();
---
<Layout title="ePlus Emoji — Open Emoji Directory">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">OPEN EMOJI DIRECTORY</p>
        <h1>Find the right emoji.<br />Copy it in one click.</h1>
        <p class="hero-copy">
          A developer-friendly emoji library inspired by the browsing experience of Slackmojis and Discadia,
          built from sources with explicit redistribution licenses.
        </p>
      </div>
      <div class="hero-stat-card">
        <strong>{emojis.length}</strong>
        <span>indexed emoji variants</span>
        <div class="source-pills">
          {sources.map((source) => <span>{source}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="shell explorer" aria-labelledby="explore-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">EXPLORE</p>
        <h2 id="explore-title">Emoji library</h2>
      </div>
      <p id="result-count">{emojis.length} results</p>
    </div>

    <div class="filters" aria-label="Emoji filters">
      <label class="search-box">
        <span class="sr-only">Search emoji</span>
        <span aria-hidden="true">⌕</span>
        <input id="emoji-search" type="search" placeholder="Search emoji, shortcode or tag…" autocomplete="off" />
      </label>
      <select id="source-filter" aria-label="Filter by source">
        <option value="all">All sources</option>
        {sources.map((source) => <option value={source.toLowerCase()}>{source}</option>)}
      </select>
      <select id="group-filter" aria-label="Filter by category">
        <option value="all">All categories</option>
        {groups.map((group) => <option value={group}>{group.replaceAll('-', ' ')}</option>)}
      </select>
      <select id="motion-filter" aria-label="Filter by animation">
        <option value="all">Static + animated</option>
        <option value="yes">Animated only</option>
        <option value="no">Static only</option>
      </select>
    </div>

    <div class="emoji-grid" id="emoji-grid">
      {emojis.map((emoji) => <EmojiCard emoji={emoji} />)}
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <div>🫥</div>
      <h3>No emoji found</h3>
      <p>Try another keyword or clear one of the filters.</p>
    </div>
  </section>

  <section class="shell source-section">
    <div>
      <p class="eyebrow">DATA SOURCES</p>
      <h2>License-aware by design</h2>
    </div>
    <div class="source-grid">
      <article>
        <h3>OpenMoji</h3>
        <p>Color SVG assets with metadata, categories, tags and author attribution.</p>
        <span>CC BY-SA 4.0</span>
      </article>
      <article>
        <h3>Twemoji</h3>
        <p>SVG emoji artwork synced from the community-maintained Twemoji repository.</p>
        <span>CC BY 4.0</span>
      </article>
      <article>
        <h3>Community</h3>
        <p>Custom emoji can be added by pull request with explicit source and license metadata.</p>
        <span>Contributor supplied</span>
      </article>
    </div>
  </section>

  <script>
    const search = document.querySelector('#emoji-search');
    const source = document.querySelector('#source-filter');
    const group = document.querySelector('#group-filter');
    const motion = document.querySelector('#motion-filter');
    const cards = [...document.querySelectorAll('[data-emoji-card]')];
    const count = document.querySelector('#result-count');
    const empty = document.querySelector('#empty-state');

    const applyFilters = () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matchesSearch = !q || card.dataset.search.includes(q);
        const matchesSource = source.value === 'all' || card.dataset.source === source.value;
        const matchesGroup = group.value === 'all' || card.dataset.group === group.value;
        const matchesMotion = motion.value === 'all' || card.dataset.animated === motion.value;
        const show = matchesSearch && matchesSource && matchesGroup && matchesMotion;
        card.hidden = !show;
        if (show) visible += 1;
      }

      count.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
      empty.hidden = visible !== 0;
    };

    [search, source, group, motion].forEach((control) => control.addEventListener('input', applyFilters));

    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy);
      const previous = button.textContent;
      button.textContent = 'Copied!';
      setTimeout(() => { button.textContent = previous; }, 900);
    });
  </script>
</Layout>
