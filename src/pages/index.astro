---
import Layout from '../layouts/Layout.astro';
import { emojiAssetUrl } from '../lib/emojiAsset';
import { withBase } from '../lib/url';
import emojis from '../data/emojis.json';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const allEmojiUrl = withBase('/emojis', base);
const animated = emojis.filter((emoji) => emoji.animated).slice(0, 18);
const staticEmoji = emojis.filter((emoji) => !emoji.animated).slice(0, 18);
const recent = [...emojis].sort((a, b) => String(b.addedAt).localeCompare(String(a.addedAt))).slice(0, 18);
const random = [...emojis].sort((a, b) => a.id.localeCompare(b.id)).filter((_, index) => index % 7 === 0).slice(0, 18);

const sections = [
  { title: 'Most Popular Animated', subtitle: 'Reaction GIFs and moving emoji', items: animated },
  { title: 'Most Popular Static', subtitle: 'Clean static emoji for chat and communities', items: staticEmoji },
  { title: 'Recently Added', subtitle: 'Fresh additions to the library', items: recent },
  { title: 'Random Picks', subtitle: 'A mixed bag worth stealing', items: random }
];

const collections = [
  { name: 'Animated', emoji: '⚡', href: `${allEmojiUrl}?motion=yes` },
  { name: 'Reactions', emoji: '😂', href: `${allEmojiUrl}?q=reaction` },
  { name: 'Faces', emoji: '😎', href: `${allEmojiUrl}?q=face` },
  { name: 'Party', emoji: '🎉', href: `${allEmojiUrl}?q=party` },
  { name: 'Animals', emoji: '🐱', href: `${allEmojiUrl}?q=animal` },
  { name: 'Symbols', emoji: '✨', href: `${allEmojiUrl}?q=symbol` }
];
---
<Layout title="ePlus Emoji — Custom emoji, GIFs and reactions" description="Browse animated GIF emoji, static emoji and reactions for Slack, Discord and communities.">
  <section class="directory-hero">
    <div class="shell directory-hero-inner">
      <div>
        <p class="eyebrow">CUSTOM EMOJI DIRECTORY</p>
        <h1>Emoji for every<br />reaction.</h1>
        <p>Browse animated GIFs, static emoji, reactions and community-ready assets — all hosted directly on ePlus Emoji.</p>
      </div>
      <form class="hero-search" action={allEmojiUrl} method="get">
        <span aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="Search emoji, reaction, meme…" aria-label="Search emoji" />
        <button type="submit">Search</button>
      </form>
      <div class="hero-count"><strong>{emojis.length}</strong><span>emoji indexed</span></div>
    </div>
  </section>

  <section class="shell collection-strip" aria-label="Emoji collections">
    {collections.map((collection) => (
      <a href={collection.href} class="collection-chip">
        <span>{collection.emoji}</span>
        <strong>{collection.name}</strong>
      </a>
    ))}
  </section>

  {sections.map((section) => section.items.length > 0 && (
    <section class="shell directory-section">
      <div class="directory-heading">
        <div>
          <h2>{section.title}</h2>
          <p>{section.subtitle}</p>
        </div>
        <a href={allEmojiUrl}>View all →</a>
      </div>
      <div class="mini-emoji-grid">
        {section.items.map((emoji) => {
          const detailUrl = withBase(`/emoji/${emoji.slug}`, base);
          const imageUrl = emojiAssetUrl(emoji, base);
          return (
            <a class="mini-emoji-card" href={detailUrl} title={emoji.name}>
              <div class="mini-preview">
                <img src={imageUrl} alt={emoji.name} loading="lazy" width="96" height="96" />
                {emoji.animated && <span class="gif-badge">GIF</span>}
              </div>
              <span class="mini-name">:{emoji.shortcode}:</span>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section class="shell directory-cta">
    <div>
      <p class="eyebrow">BROWSE EVERYTHING</p>
      <h2>Thousands of combinations, one searchable catalog.</h2>
    </div>
    <a href={allEmojiUrl}>Open all emojis</a>
  </section>
</Layout>
