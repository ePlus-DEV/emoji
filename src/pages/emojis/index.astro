---
import Layout from '../../layouts/Layout.astro';
import EmojiCard from '../../components/EmojiCard.astro';
import { catalogConfig } from '../../config/catalog';
import { withBase } from '../../lib/url';
import emojis from '../../data/emojis.json';
import '../../styles/pagination.css';

const PAGE_SIZE = catalogConfig.pageSize;
const DEFAULT_MODE = catalogConfig.mode;
const initialEmojis = emojis.slice(0, PAGE_SIZE);
const categories = [...new Set(emojis.map((emoji) => emoji.category || emoji.group.replaceAll('-', ' ')))].sort();
const sources = [...new Set(emojis.map((emoji) => emoji.sourceLabel))].sort();
const base = import.meta.env.BASE_URL;
const apiUrl = withBase('/api/emojis.json', base);
const totalPages = Math.max(1, Math.ceil(emojis.length / PAGE_SIZE));
---
<Layout
  title="Browse all emoji — ePlus Emoji"
  description="Search the complete ePlus Emoji catalog by name, shortcode, category, source and animation type."
>
  <section
    class="shell catalog-page"
    id="explorer"
    aria-labelledby="page-title"
    data-api-url={apiUrl}
    data-base={base}
    data-total={emojis.length}
    data-default-mode={DEFAULT_MODE}
    data-page-size={PAGE_SIZE}
    data-scroll-root-margin={catalogConfig.scrollRootMargin}
  >
    <header class="browse-header">
      <p class="eyebrow">Emoji directory</p>
      <h1 id="page-title">Browse emoji</h1>
      <p>Search by name, shortcode or tag, then narrow results with the filters below.</p>
    </header>

    <div class="catalog-controls" aria-label="Emoji search and filters">
      <label class="search-box catalog-search">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <span class="sr-only">Search emoji</span>
        <input id="emoji-search" type="search" placeholder="Search emoji, :shortcode:, tag or category" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
      </label>

      <div class="filter-row">
        <select id="source-filter" aria-label="Filter by source">
          <option value="all">All sources</option>
          {sources.map((source) => <option value={source.toLowerCase()}>{source}</option>)}
        </select>
        <select id="category-filter" aria-label="Filter by category">
          <option value="all">All categories</option>
          {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
        </select>
        <select id="motion-filter" aria-label="Filter by animation">
          <option value="all">Static + animated</option>
          <option value="yes">Animated only</option>
          <option value="no">Static only</option>
        </select>
        <button class="clear-filters" id="clear-filters" type="button" hidden>Clear</button>
      </div>
    </div>

    <div class="results-toolbar">
      <p class="results-summary" id="range-count" aria-live="polite">
        Showing 1–{Math.min(PAGE_SIZE, emojis.length).toLocaleString('en-US')} of {emojis.length.toLocaleString('en-US')}
      </p>

      <div class="browse-mode-switcher" role="group" aria-label="Choose how emoji are loaded">
        <button
          class:list={['browse-mode-button', { 'is-active': DEFAULT_MODE === 'scroll' }]}
          type="button"
          data-browse-mode="scroll"
          aria-pressed={DEFAULT_MODE === 'scroll' ? 'true' : 'false'}
          title="Automatically load more as you scroll"
        >
          <span aria-hidden="true">↕</span> Scroll
        </button>
        <button
          class:list={['browse-mode-button', { 'is-active': DEFAULT_MODE === 'pagination' }]}
          type="button"
          data-browse-mode="pagination"
          aria-pressed={DEFAULT_MODE === 'pagination' ? 'true' : 'false'}
          title="Browse with page numbers"
        >
          <span aria-hidden="true">☷</span> Pages
        </button>
      </div>
    </div>

    <div class="emoji-grid" id="emoji-grid">
      {initialEmojis.map((emoji) => <EmojiCard emoji={emoji} />)}
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <div>🫥</div>
      <h2>No emoji found</h2>
      <p>Try another keyword or clear one of the filters.</p>
    </div>

    <div class="infinite-loader" id="infinite-loader" hidden={DEFAULT_MODE !== 'scroll' || emojis.length <= PAGE_SIZE}>
      <span class="infinite-loader-spinner" id="infinite-loader-spinner" aria-hidden="true"></span>
      <span id="infinite-loader-status">{Math.min(PAGE_SIZE, emojis.length).toLocaleString('en-US')} of {emojis.length.toLocaleString('en-US')} loaded</span>
      <button class="load-more-fallback" id="load-more-fallback" type="button" hidden>Load {PAGE_SIZE} more</button>
    </div>

    <nav class="pagination" id="pagination" aria-label="Emoji pagination" hidden={DEFAULT_MODE !== 'pagination' || totalPages <= 1}>
      <button class="pagination-nav" type="button" data-page-action="prev">← Prev</button>
      <div class="pagination-pages" id="pagination-pages"></div>
      <button class="pagination-nav" type="button" data-page-action="next">Next →</button>
    </nav>
  </section>

  <script>
    const explorer = document.querySelector('#explorer');
    const grid = document.querySelector('#emoji-grid');
    const search = document.querySelector('#emoji-search');
    const source = document.querySelector('#source-filter');
    const category = document.querySelector('#category-filter');
    const motion = document.querySelector('#motion-filter');
    const clearFilters = document.querySelector('#clear-filters');
    const rangeCount = document.querySelector('#range-count');
    const modeButtons = [...document.querySelectorAll('[data-browse-mode]')];
    const empty = document.querySelector('#empty-state');
    const infiniteLoader = document.querySelector('#infinite-loader');
    const loaderSpinner = document.querySelector('#infinite-loader-spinner');
    const loaderStatus = document.querySelector('#infinite-loader-status');
    const loadMoreFallback = document.querySelector('#load-more-fallback');
    const pagination = document.querySelector('#pagination');
    const paginationPages = document.querySelector('#pagination-pages');
    const previousButton = pagination.querySelector('[data-page-action="prev"]');
    const nextButton = pagination.querySelector('[data-page-action="next"]');

    const apiUrl = explorer.dataset.apiUrl;
    const base = explorer.dataset.base || '/';
    const defaultMode = explorer.dataset.defaultMode === 'pagination' ? 'pagination' : 'scroll';
    const PAGE_SIZE = Math.max(1, Number.parseInt(explorer.dataset.pageSize || '48', 10));
    const scrollRootMargin = explorer.dataset.scrollRootMargin || '700px 0px';
    const totalCatalogCount = Number.parseInt(explorer.dataset.total || '0', 10);
    const basePrefix = base === '/' ? '' : base.replace(/\/$/, '');
    const preferenceKey = 'emoji-browse-mode';

    const params = new URLSearchParams(window.location.search);
    const isBrowseMode = (value) => value === 'scroll' || value === 'pagination';

    let storedMode = null;
    try {
      storedMode = window.localStorage.getItem(preferenceKey);
    } catch {}

    const requestedMode = params.get('view');
    let mode = isBrowseMode(requestedMode)
      ? requestedMode
      : isBrowseMode(storedMode)
        ? storedMode
        : defaultMode;

    let catalogPromise;
    let filteredCatalog = null;
    let visibleCount = PAGE_SIZE;
    let searchTimer;
    let isLoadingMore = false;
    let infiniteObserver = null;

    const requestedPage = Number.parseInt(params.get('page') || '1', 10);
    let currentPage = mode === 'pagination' && Number.isFinite(requestedPage) && requestedPage > 0
      ? requestedPage
      : 1;

    const withBase = (path) => `${basePrefix}${path.startsWith('/') ? path : `/${path}`}`;

    const twemojiFilename = (hexcode = '') => `${hexcode
      .split('-')
      .filter((part) => part.toUpperCase() !== 'FE0F')
      .map((part) => part.toLowerCase().replace(/^0+/, '') || '0')
      .join('-')}.svg`;

    const assetUrl = (emoji) => {
      if (emoji.image?.startsWith('/emojis/')) return withBase(emoji.image);
      if (emoji.source === 'openmoji') return withBase(`/emojis/openmoji/${emoji.hexcode}.svg`);
      if (emoji.source === 'twemoji') return withBase(`/emojis/twemoji/${twemojiFilename(emoji.hexcode)}`);
      return emoji.image || '';
    };

    const createEmojiCard = (emoji) => {
      const detailUrl = withBase(`/emoji/${emoji.slug}`);
      const categoryName = emoji.category || String(emoji.group || '').replaceAll('-', ' ');
      const article = document.createElement('article');
      article.className = 'emoji-card';
      article.dataset.emojiCard = '';

      const preview = document.createElement('a');
      preview.className = 'emoji-preview';
      preview.href = detailUrl;
      preview.setAttribute('aria-label', `Open ${emoji.name}`);

      const image = document.createElement('img');
      image.src = assetUrl(emoji);
      image.alt = emoji.name;
      image.loading = 'lazy';
      image.width = 128;
      image.height = 128;
      preview.append(image);

      if (emoji.animated) {
        const badge = document.createElement('span');
        badge.className = 'card-motion-badge';
        badge.textContent = 'GIF';
        preview.append(badge);
      }

      const body = document.createElement('div');
      body.className = 'emoji-card-body';

      const titleRow = document.createElement('div');
      titleRow.className = 'emoji-title-row';

      const name = document.createElement('a');
      name.className = 'emoji-name';
      name.href = detailUrl;
      name.textContent = emoji.name;

      const nativeEmoji = document.createElement('span');
      nativeEmoji.className = 'native-emoji';
      nativeEmoji.setAttribute('aria-hidden', 'true');
      nativeEmoji.textContent = emoji.emoji || '';
      titleRow.append(name, nativeEmoji);

      const shortcode = document.createElement('button');
      shortcode.className = 'shortcode';
      shortcode.type = 'button';
      shortcode.dataset.copy = `:${emoji.shortcode}:`;
      shortcode.title = 'Copy shortcode';
      shortcode.setAttribute('aria-label', `Copy shortcode :${emoji.shortcode}:`);
      shortcode.textContent = `:${emoji.shortcode}:`;

      const meta = document.createElement('div');
      meta.className = 'emoji-meta';
      const metaCategory = document.createElement('span');
      metaCategory.textContent = categoryName;
      const metaFormat = document.createElement('span');
      metaFormat.textContent = emoji.animated ? 'Animated' : String(emoji.format || 'Static').toUpperCase();
      meta.append(metaCategory, metaFormat);

      body.append(titleRow, shortcode, meta);
      article.append(preview, body);
      return article;
    };

    const buildFragment = (items) => {
      const fragment = document.createDocumentFragment();
      for (const emoji of items) fragment.append(createEmojiCard(emoji));
      return fragment;
    };

    const loadCatalog = async () => {
      if (!catalogPromise) {
        catalogPromise = fetch(apiUrl)
          .then((response) => {
            if (!response.ok) throw new Error(`Catalog request failed: ${response.status}`);
            return response.json();
          })
          .catch((error) => {
            catalogPromise = undefined;
            throw error;
          });
      }
      return catalogPromise;
    };

    const setSelectFromParam = (control, value) => {
      if (!value) return;
      const normalized = value.toLowerCase();
      const exists = [...control.options].some((option) => option.value === normalized);
      if (exists) control.value = normalized;
    };

    search.value = params.get('q') || '';
    setSelectFromParam(source, params.get('source'));
    setSelectFromParam(category, params.get('category') || params.get('group'));
    setSelectFromParam(motion, params.get('motion'));

    const hasActiveFilters = () => Boolean(
      search.value.trim() ||
      source.value !== 'all' ||
      category.value !== 'all' ||
      motion.value !== 'all'
    );

    const syncFilterUI = () => {
      clearFilters.hidden = !hasActiveFilters();
    };

    const updateModeUI = () => {
      for (const button of modeButtons) {
        const active = button.dataset.browseMode === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
    };

    const updateUrl = () => {
      const url = new URL(window.location.href);
      const q = search.value.trim();
      if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
      if (source.value !== 'all') url.searchParams.set('source', source.value); else url.searchParams.delete('source');
      if (category.value !== 'all') url.searchParams.set('category', category.value); else url.searchParams.delete('category');
      if (motion.value !== 'all') url.searchParams.set('motion', motion.value); else url.searchParams.delete('motion');
      url.searchParams.delete('group');
      url.searchParams.set('view', mode);

      if (mode === 'pagination' && currentPage > 1) url.searchParams.set('page', String(currentPage));
      else url.searchParams.delete('page');

      window.history.replaceState({}, '', url);
    };

    const filterCatalog = (catalog) => {
      const q = search.value.trim().toLowerCase();
      return catalog.filter((emoji) => {
        const categoryName = (emoji.category || String(emoji.group || '').replaceAll('-', ' ')).toLowerCase();
        const searchText = [
          emoji.name,
          emoji.shortcode,
          emoji.sourceLabel,
          emoji.group,
          emoji.category,
          emoji.categorySlug,
          ...(emoji.tags || [])
        ].filter(Boolean).join(' ').toLowerCase();

        return (!q || searchText.includes(q)) &&
          (source.value === 'all' || String(emoji.sourceLabel || '').toLowerCase() === source.value) &&
          (category.value === 'all' || categoryName === category.value) &&
          (motion.value === 'all' || (emoji.animated ? 'yes' : 'no') === motion.value);
      });
    };

    const pageItems = (totalPages) => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
      const items = [1];
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      if (start > 2) items.push('ellipsis-start');
      for (let page = start; page <= end; page += 1) items.push(page);
      if (end < totalPages - 1) items.push('ellipsis-end');
      items.push(totalPages);
      return items;
    };

    const renderPagination = (total) => {
      if (mode !== 'pagination') {
        pagination.hidden = true;
        return;
      }

      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      pagination.hidden = totalPages <= 1 || total === 0;
      paginationPages.replaceChildren();
      previousButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;

      for (const item of pageItems(totalPages)) {
        if (typeof item === 'string') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'pagination-ellipsis';
          ellipsis.textContent = '…';
          paginationPages.append(ellipsis);
          continue;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pagination-page';
        button.textContent = String(item);
        button.dataset.page = String(item);
        if (item === currentPage) {
          button.classList.add('is-active');
          button.setAttribute('aria-current', 'page');
        }
        paginationPages.append(button);
      }
    };

    const updateInfiniteLoader = (total, shown) => {
      if (mode !== 'scroll') {
        infiniteLoader.hidden = true;
        return;
      }
      const hasMore = shown < total;
      infiniteLoader.hidden = !hasMore || total === 0;
      if (hasMore) loaderStatus.textContent = `${shown.toLocaleString('en-US')} of ${total.toLocaleString('en-US')} loaded`;
    };

    const configureInfiniteScroll = () => {
      if (infiniteObserver) {
        infiniteObserver.disconnect();
        infiniteObserver = null;
      }
      loadMoreFallback.hidden = true;

      if (mode !== 'scroll' || infiniteLoader.hidden) return;
      if (!('IntersectionObserver' in window)) {
        loadMoreFallback.hidden = false;
        return;
      }

      infiniteObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadNextBatch();
      }, { rootMargin: scrollRootMargin });
      infiniteObserver.observe(infiniteLoader);
    };

    const renderScrollCatalog = () => {
      const items = filteredCatalog || [];
      const shown = Math.min(visibleCount, items.length);
      grid.replaceChildren(buildFragment(items.slice(0, shown)));
      rangeCount.textContent = items.length === 0
        ? '0 results'
        : `Showing 1–${shown.toLocaleString('en-US')} of ${items.length.toLocaleString('en-US')}`;
      empty.hidden = items.length !== 0;
      pagination.hidden = true;
      updateInfiniteLoader(items.length, shown);
      syncFilterUI();
      updateUrl();
      configureInfiniteScroll();
    };

    const renderPaginationCatalog = ({ scrollIntoView = false } = {}) => {
      const items = filteredCatalog || [];
      const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = Math.min(start + PAGE_SIZE, items.length);
      grid.replaceChildren(buildFragment(items.slice(start, end)));
      rangeCount.textContent = items.length === 0
        ? '0 results'
        : `Showing ${(start + 1).toLocaleString('en-US')}–${end.toLocaleString('en-US')} of ${items.length.toLocaleString('en-US')}`;
      empty.hidden = items.length !== 0;
      infiniteLoader.hidden = true;
      if (infiniteObserver) infiniteObserver.disconnect();
      renderPagination(items.length);
      syncFilterUI();
      updateUrl();
      if (scrollIntoView) explorer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const renderInitialState = () => {
      rangeCount.textContent = totalCatalogCount === 0
        ? '0 results'
        : `Showing 1–${Math.min(PAGE_SIZE, totalCatalogCount).toLocaleString('en-US')} of ${totalCatalogCount.toLocaleString('en-US')}`;
      empty.hidden = totalCatalogCount !== 0;

      if (mode === 'pagination') {
        infiniteLoader.hidden = true;
        renderPagination(totalCatalogCount);
      } else {
        pagination.hidden = true;
        infiniteLoader.hidden = totalCatalogCount <= PAGE_SIZE;
        updateInfiniteLoader(totalCatalogCount, Math.min(PAGE_SIZE, totalCatalogCount));
        configureInfiniteScroll();
      }
      syncFilterUI();
      updateUrl();
    };

    const applyFilters = async ({ reset = true } = {}) => {
      if (reset) {
        currentPage = 1;
        visibleCount = PAGE_SIZE;
      }
      syncFilterUI();
      rangeCount.textContent = 'Loading matching emoji…';

      try {
        const catalog = await loadCatalog();
        filteredCatalog = hasActiveFilters() ? filterCatalog(catalog) : catalog;
        if (mode === 'pagination') renderPaginationCatalog();
        else renderScrollCatalog();
      } catch (error) {
        console.error(error);
        rangeCount.textContent = 'Could not load the emoji index. Please try again.';
      }
    };

    async function loadNextBatch() {
      if (mode !== 'scroll' || isLoadingMore || infiniteLoader.hidden) return;
      isLoadingMore = true;
      loaderSpinner.classList.add('is-loading');
      loaderStatus.textContent = 'Loading more emoji…';
      loadMoreFallback.disabled = true;

      try {
        const catalog = await loadCatalog();
        if (!filteredCatalog) filteredCatalog = hasActiveFilters() ? filterCatalog(catalog) : catalog;
        const start = Math.min(visibleCount, filteredCatalog.length);
        const end = Math.min(start + PAGE_SIZE, filteredCatalog.length);
        grid.append(buildFragment(filteredCatalog.slice(start, end)));
        visibleCount = end;
        rangeCount.textContent = filteredCatalog.length === 0
          ? '0 results'
          : `Showing 1–${visibleCount.toLocaleString('en-US')} of ${filteredCatalog.length.toLocaleString('en-US')}`;
        updateInfiniteLoader(filteredCatalog.length, visibleCount);
        loadMoreFallback.hidden = true;
      } catch (error) {
        console.error(error);
        loaderStatus.textContent = 'Could not load more emoji.';
        loadMoreFallback.hidden = false;
      } finally {
        isLoadingMore = false;
        loaderSpinner.classList.remove('is-loading');
        loadMoreFallback.disabled = false;
      }
    }

    const goToPage = async (page) => {
      if (mode !== 'pagination') return;
      const total = filteredCatalog?.length ?? totalCatalogCount;
      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      currentPage = Math.min(Math.max(page, 1), totalPages);
      rangeCount.textContent = 'Loading page…';

      try {
        if (!filteredCatalog) {
          const catalog = await loadCatalog();
          filteredCatalog = hasActiveFilters() ? filterCatalog(catalog) : catalog;
        }
        renderPaginationCatalog({ scrollIntoView: true });
      } catch (error) {
        console.error(error);
        rangeCount.textContent = 'Could not load this page. Please try again.';
      }
    };

    const switchMode = async (nextMode) => {
      if (!isBrowseMode(nextMode) || nextMode === mode) return;
      mode = nextMode;
      currentPage = 1;
      visibleCount = PAGE_SIZE;
      updateModeUI();

      try {
        window.localStorage.setItem(preferenceKey, mode);
      } catch {}

      if (filteredCatalog) {
        if (mode === 'pagination') renderPaginationCatalog();
        else renderScrollCatalog();
      } else if (hasActiveFilters()) {
        await applyFilters({ reset: true });
      } else {
        renderInitialState();
      }
    };

    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => applyFilters({ reset: true }), 180);
    });

    [source, category, motion].forEach((control) =>
      control.addEventListener('input', () => applyFilters({ reset: true }))
    );

    clearFilters.addEventListener('click', () => {
      search.value = '';
      source.value = 'all';
      category.value = 'all';
      motion.value = 'all';
      filteredCatalog = null;
      applyFilters({ reset: true });
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => switchMode(button.dataset.browseMode));
    });

    loadMoreFallback.addEventListener('click', loadNextBatch);

    pagination.addEventListener('click', (event) => {
      const target = event.target.closest('button');
      if (!target) return;
      if (target.dataset.pageAction === 'prev') goToPage(currentPage - 1);
      else if (target.dataset.pageAction === 'next') goToPage(currentPage + 1);
      else if (target.dataset.page) goToPage(Number.parseInt(target.dataset.page, 10));
    });

    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-copy]');
      if (!button) return;
      await navigator.clipboard.writeText(button.dataset.copy);
      const previous = button.textContent;
      button.textContent = 'Copied!';
      setTimeout(() => { button.textContent = previous; }, 900);
    });

    const initialize = async () => {
      updateModeUI();
      syncFilterUI();

      if (hasActiveFilters()) {
        await applyFilters({ reset: false });
        return;
      }

      if (mode === 'pagination' && currentPage > 1) {
        await goToPage(currentPage);
        return;
      }

      currentPage = 1;
      renderInitialState();
    };

    initialize();
  </script>
</Layout>
